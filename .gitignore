# === Статистика языков GitHub (Linguist) ===
# Прячем фронтенд из подсчёта языков — акцент на backend (Python/FastAPI)
frontend_crm/* linguist-vendored=true

# Автогенерируемые файлы — не считать как "написанный" код
frontend_crm/package-lock.json linguist-generated=true
frontend_crm/package.json linguist-generated=false

# Миграции Alembic — тоже генерируются автоматически, но это Python,
# можно оставить как есть (они честно показывают твою работу с БД)
# beckend_crm/alembic/versions/* linguist-generated=true

# === Нормализация строк (стандартная практика) ===
* text=auto eol=lf

# Бинарные файлы — не трогать построчно
*.png binary
*.jpg binary
*.jpeg binary
*.svg binary
*.ico binary